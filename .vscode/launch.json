{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug git-along",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=git-along"],
                "filter": { "name": "git-along", "kind": "bin" }
            },
            "cwd": "${workspaceFolder}",
            "args": ["${command:pickArgs}"]
        }
    ]
}
