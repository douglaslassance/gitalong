#!/bin/sh
# Installed by `git along setup --update-hooks`.

# Git LFS — invoke when present, warn (don't fail) when absent.
if command -v git-lfs >/dev/null 2>&1; then
	git lfs post-commit "$@"
fi

# Git Along
if command -v git-along >/dev/null 2>&1; then
	git along update
else
	echo "git-along is not installed; skipping tracked-commits update." >&2
fi
